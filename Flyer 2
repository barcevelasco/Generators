        // ---------- Normalización y extracción de programa ----------
        function normalizeText(text) {
            return text.toLowerCase()
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                .replace(/[^\w\s]/g, ' ')
                .trim()
                .replace(/\s+/g, ' ');
        }

        function extractPrograma(grado) {
            if (!grado || typeof grado !== 'string') return "Desconocido";
            let prog = grado.toLowerCase();
            const prefijos = ["licenciatura en ", "maestria en ", "doctorado en ", "especialidad en "];
            for (const p of prefijos) {
                if (prog.startsWith(p)) {
                    prog = prog.slice(p.length);
                    break;
                }
            }
            prog = prog.replace(/ unam$/, '').trim();
            return prog || "General";
        }

        function extraerGradoCorto(grado) {
            if (!grado) return "GRADO";
            const g = grado.toLowerCase();
            if (g.includes("licenciatura")) return "LICENCIATURA";
            if (g.includes("maestria")) return "MAESTRÍA";
            if (g.includes("doctorado")) return "DOCTORADO";
            if (g.includes("especialidad")) return "ESPECIALIDAD";
            return "POSGRADO";
        }

        // ---------- Cargar dataset y preparar filtros ----------
        async function loadDataset() {
            try {
                const response = await fetch('muestra_tesis_norm.json');
                if (!response.ok) throw new Error(`No se encontró muestra_tesis_norm.json`);
                dataset = await response.json();
                if (!dataset.length) throw new Error('Dataset vacío');

                const dim = dataset[0].embedding.length;
                allEmbeddings = new Float32Array(dataset.length * dim);
                for (let i = 0; i < dataset.length; i++) {
                    const emb = dataset[i].embedding;
                    for (let j = 0; j < dim; j++) {
                        allEmbeddings[i * dim + j] = emb[j];
                    }
                    // Extraer programa normalizado
                    const programa = extractPrograma(dataset[i].grado);
                    dataset[i].programa_clean = programa;
                    dataset[i].grado_corto = extraerGradoCorto(dataset[i].grado);
                    availableProgramas.add(programa);
                }

                dataset.forEach(d => availableCategories.add(d.categoria));
                availableCategories = Array.from(availableCategories).sort();
                renderFilterChips();

                // Ordenar programas por frecuencia
                const programaCounts = new Map();
                dataset.forEach(d => {
                    const p = d.programa_clean;
                    programaCounts.set(p, (programaCounts.get(p) || 0) + 1);
                });
                const sortedProgramas = Array.from(programaCounts.keys()).sort((a,b) => programaCounts.get(b) - programaCounts.get(a));
                availableProgramas = new Set(sortedProgramas);
                renderProgramaFilterChips("");

                resultsDiv.innerHTML = `<div class="info-message">✅ Dataset cargado: ${dataset.length} tesis. Modelo listo.</div>`;
                return true;
            } catch (err) {
                resultsDiv.innerHTML = `<div class="info-message">❌ Error: ${err.message}<br>¿Tienes "muestra_tesis_norm.json"?</div>`;
                return false;
            }
        }

