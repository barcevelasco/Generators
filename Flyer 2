        .verb-popup { position: absolute; z-index: 30; background: white; border-radius: 1rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2); border: 1px solid #ece8e0; padding: 1rem; width: 100%; max-width: 500px; margin-top: 0.5rem; display: none; backdrop-filter: blur(4px); background: rgba(255,255,255,0.95); }
