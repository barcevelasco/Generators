        // ---------- Gráfico de palabras clave ----------
        function plotKeywordFrequencies() {
            if (keywordsList.length === 0) {
                alert("Agrega al menos una palabra clave.");
                return;
            }
            const uniqueKeywords = [...new Set(keywordsList.map(k => normalizeText(k)))];
            const startYear = 1880;
            const endYear = 2026;
            const years = Array.from({length: endYear - startYear + 1}, (_, i) => startYear + i);
            
            const tracesByKeyword = {};
            for (const kw of uniqueKeywords) {
                tracesByKeyword[kw] = new Array(years.length).fill(0);
            }
            for (const tesis of dataset) {
                const year = tesis.año;
                if (!year || year < startYear || year > endYear) continue;
                const title = (tesis.titulo || "").toLowerCase();
                for (const kw of uniqueKeywords) {
                    if (title.includes(kw)) {
                        const idx = year - startYear;
                        tracesByKeyword[kw][idx]++;
                    }
                }
            }
            const rows = uniqueKeywords.length;
            let fig = {
                data: [],
                layout: {
                    title: `Tendencias de palabras clave (subplots independientes)`,
                    height: 300 * rows,
                    showlegend: false,
                    grid: { rows: rows, columns: 1, pattern: 'independent' }
                }
            };
            for (let i = 0; i < uniqueKeywords.length; i++) {
                const kw = uniqueKeywords[i];
                fig.data.push({
                    x: years,
                    y: tracesByKeyword[kw],
                    name: kw,
                    type: 'scatter',
                    mode: 'lines+markers',
                    line: { shape: 'linear' },
                    yaxis: `y${i+1}`
                });
                fig.layout[`yaxis${i+1}`] = {
                    title: `Frecuencia (${kw})`,
                    domain: [(rows - i - 1) / rows, (rows - i) / rows]
                };
            }
            fig.layout.xaxis = { title: 'Año', domain: [0,1] };
            Plotly.newPlot(chartDiv, fig.data, fig.layout, { responsive: true });
            chartDiv.style.display = 'block';
        }
        
        // Botón de re‑ranking
        const rerankButton = document.createElement('button');
        rerankButton.textContent = '🤖 Reordenar con IA (Groq)';
        rerankButton.style.marginTop = '1rem';
        rerankButton.style.padding = '0.5rem 1rem';
        rerankButton.style.borderRadius = '2rem';
        rerankButton.style.border = 'none';
        rerankButton.style.backgroundColor = '#6a4e2e';
        rerankButton.style.color = 'white';
        rerankButton.style.cursor = 'pointer';
        rerankButton.onclick = rerankWithAI;
        const resultsContainer = document.getElementById('resultsContainer');
        if (resultsContainer) {
            resultsContainer.parentNode.insertBefore(rerankButton, resultsContainer.nextSibling);
        }
        
        plotBtn.addEventListener('click', plotKeywordFrequencies);
        searchBtn.addEventListener('click', performSearch);
        topKSelect.addEventListener('change', () => { if (lastQueryVector !== null) performSearch(); });
        loadDataset();
        getEmbedder();
    </script>
</body>
