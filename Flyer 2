        .full-verbs-section h4 { font-size: 0.7rem; font-weight: 600; color: #5a4a2e; }
        .verb-bulb { display: inline-block; margin-left: 0.5rem; font-size: 1rem; cursor: pointer; background: rgba(0,0,0,0.08); border-radius: 50%; width: 1.4rem; height: 1.4rem; text-align: center; line-height: 1.4rem; transition: background 0.2s; }
