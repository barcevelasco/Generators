        .search-panel { background: white; border-radius: 1.5rem; box-shadow: 0 8px 20px rgba(0,0,0,0.03); padding: 1.5rem; margin-bottom: 2rem; border: 1px solid #ece8e0; position: relative; }
        .input-group { margin-bottom: 1.2rem; position: relative; }
        label { display: block; font-size: 0.8rem; font-weight: 600; color: #5a4a2e; margin-bottom: 0.4rem; }
        textarea, input { width: 100%; padding: 0.75rem; border: 1px solid #ddd6cc; border-radius: 1rem; font-family: inherit; font-size: 0.9rem; background: #fffefc; }
