        .img-container { max-height: 260px; overflow: hidden; }

        /* ===== Estilos del buscador y componentes ===== */
        .chips-container { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
