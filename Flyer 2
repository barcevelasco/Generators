        .verb-suggestion-section { margin-bottom: 0.8rem; padding: 0.3rem; border-left: 3px solid; border-radius: 0 0.5rem 0.5rem 0; }
        .verb-suggestion-section[data-cat="Recordar"] { border-left-color: #a8d5e5; background: #f5fafd; }
        .verb-suggestion-section[data-cat="Comprender"] { border-left-color: #b5e3c8; background: #f5fdf8; }
        .verb-suggestion-section[data-cat="Aplicar"] { border-left-color: #ffe0a3; background: #fffbf0; }
        .verb-suggestion-section[data-cat="Analizar"] { border-left-color: #f7c5c5; background: #fff6f6; }
        .verb-suggestion-section[data-cat="Evaluar"] { border-left-color: #d4b8e0; background: #fdfaff; }
        .verb-suggestion-section[data-cat="Crear"] { border-left-color: #c5e0d4; background: #f5fef9; }
        .verb-suggestion-section h4 { font-size: 0.75rem; font-weight: 600; color: #8B5A2B; margin-bottom: 0.3rem; }
        .verb-chips-suggest { display: flex; flex-wrap: wrap; gap: 0.3rem; }
        .verb-chip-suggest { background: #f0ede7; padding: 0.2rem 0.6rem; border-radius: 2rem; font-size: 0.7rem; cursor: pointer; transition: 0.1s; }
        .verb-chip-suggest:hover { background: #e0d6c8; }
        .expand-btn { text-align: center; margin-top: 0.5rem; font-size: 0.7rem; color: #8B5A2B; cursor: pointer; }
        .full-verbs-list { display: none; margin-top: 0.8rem; max-height: 300px; overflow-y: auto; border-top: 1px solid #f0eade; padding-top: 0.5rem; }
